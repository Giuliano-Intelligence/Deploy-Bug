{
  "name": "deploybug",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "tsx watch apps/gate/src/server.ts",
    "start": "tsx apps/gate/src/server.ts",
    "test": "node --import tsx --test tests/*.test.ts",
    "demo": "bash scripts/demo.sh",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@composio/core": "^0.25.0",
    "@hono/node-server": "^2.1.5",
    "@langchain/openai": "^1.6.2",
    "@types/qrcode": "^1.5.6",
    "deepagents": "^1.15.1",
    "hono": "^4.13.13",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^5.6.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^20.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
