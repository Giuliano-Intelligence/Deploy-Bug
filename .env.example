PORT=8787
# Model brain (OpenAI-compatible)
REDPILL_BASE_URL=https://api.redpill.ai/v1
REDPILL_API_KEY=
# Escalation model
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
# Connectors
# Composio keys are per user: entered in the PWA, stored AES-256-GCM encrypted in VAULT_FILE
DEPLOYBUG_MASTER_KEY=
VAULT_FILE=data/vault.json
# Optional (mux app disabled by default)
MUX_TOKEN_ID=
MUX_TOKEN_SECRET=
# Telegram approvals (or put the token in /tmp/keys/telegram)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Gate auth for agents calling POST /requests
GATE_AGENT_TOKEN=change-me
# Set to 1 to run without real tool calls (demo/tests)
QUEUE_BACKEND=memory
QUEUE_CONCURRENCY=2
DRY_RUN=1
# Separate alert bot (optional; falls back to main bot)
TELEGRAM_ALERT_TOKEN=
TELEGRAM_ALERT_CHAT_ID=
# Optional Hive likeness/AI-content check (off by default; key also read from /tmp/keys/hive)
HIVE_ENABLED=0
HIVE_API_KEY=
# Default timezone for messages (users can override via PUT /users/:user/profile)
DEFAULT_TZ=Europe/London
